SET enable_seqscan = off;
-- type and casts
SELECT '[1,-2,32767]'::intvec(3);
    intvec    
--------------
 [1,-2,32767]
(1 row)

SELECT vector_dims('[1,-2,3]'::intvec);
 vector_dims 
-------------
           3
(1 row)

SELECT '[1,2,3]'::intvec <-> '[4,6,3]'::intvec;
 ?column? 
----------
        5
(1 row)

SELECT ARRAY[1,-2,3]::intvec;
  array   
----------
 [1,-2,3]
(1 row)

SELECT '[1,-2,3]'::vector::intvec;
  intvec  
----------
 [1,-2,3]
(1 row)

SELECT '[1,-2,3]'::intvec::vector;
  vector  
----------
